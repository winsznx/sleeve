# Sleeve environment. Copy to .env.local (gitignored) and fill the blanks. app/.env.local links to it, the keeper
# and the deploy scripts read it. The app's Cloudflare build keeps every non-public value out of the worker (D-033). Contract addresses are not here: they come from packages/core
# (contracts/deployments/4663.json). Private keys never go in this file; they stay in ~/.sleeve-keys at mode 600.

# --- Chain ---------------------------------------------------------------------------------------------------
# Public Robinhood Chain RPC: rate limited, keeps only minutes of history. The verifier uses it on purpose,
# so it never shares a provider with the keeper.
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
# Archive RPC for forked tests at pinned blocks. The QuickNode endpoint can replace dRPC here.
FORK_RPC=https://robinhood.drpc.org
# QuickNode endpoint on Robinhood Chain mainnet (HTTPS, token auth, no referrer lock): the keeper's RPC and the
# HP2 rerun. Server only; keep it out of NEXT_PUBLIC_ variables.
KEEPER_RPC=

# --- App (Cloudflare Workers, D-033) -------------------------------------------------------------------------
# Production always builds with data source "chain", origin https://trysleeve.xyz and passkey relying party
# trysleeve.xyz (app/scripts/cloudflare.mjs, D-034). These three are for local runs: "mock" shows labeled sample
# data, and a local passkey needs http://localhost:3000 with relying party localhost.
NEXT_PUBLIC_SLEEVE_DATA_SOURCE=mock
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PASSKEY_RP_ID=
# Browser reads, a second QuickNode endpoint, never the keeper's: every NEXT_PUBLIC_ value ships in the page. Lock it
# at QuickNode with a referrer allowlist, a method allowlist without eth_getLogs (log reads go to the public RPC) and
# per-IP limits (D-035). Empty reads everything through the public RPC.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
# Reown (WalletConnect) project id from cloud.reown.com, with the production origin on its allowlist.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# ZeroDev bundler and paymaster for Robinhood Chain 4663, from the project's network list at dashboard.zerodev.app:
# https://rpc.zerodev.app/api/v3/<project id>/chain/4663. Not a QuickNode URL. The project needs a sponsorship
# gas policy for 4663 and the production origins under Access Control.
NEXT_PUBLIC_ZERODEV_RPC_URL=
# Supabase project (supabase.com/dashboard): inbox index, passkey credential records, cards.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. The deploy stores it on the worker as a Cloudflare secret.
SUPABASE_SERVICE_ROLE_KEY=
# Local runs only: pretend the request came from this ISO country for the eligibility gate. Production ignores it.
ELIGIBILITY_IP_COUNTRY=

# --- Keeper (VPS) --------------------------------------------------------------------------------------------
# The keeper's key lives in a file on the VPS at mode 600, never here.
KEEPER_PRIVATE_KEY_FILE=/opt/sleeve/secrets/keeper.key
# Hold sorting while the base fee is above this, in gwei (PRD 7.2).
KEEPER_GAS_CEILING_GWEI=0.1
KEEPER_POLL_MS=5000
KEEPER_HEALTH_PORT=8787

# --- Verification and deploy ---------------------------------------------------------------------------------
# Optional: Blockscout PRO API key (dev.blockscout.com) and Etherscan key for robin.etherscan.io.
BLOCKSCOUT_API_KEY=
ETHERSCAN_API_KEY=
# The app deploys with wrangler's own login (pnpm --filter @sleeve/app exec wrangler login); nothing goes here.
