# Public Robinhood Chain RPC. Serves only a few minutes of historical state. Used by the verifier.
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
# Archive RPC for forked tests at pinned blocks. dRPC's public endpoint until the Alchemy app exists.
FORK_RPC=https://robinhood.drpc.org
# Keeper RPC, a different provider from the verifier.
KEEPER_RPC=
# Never put private keys here. Load them from ~/.sleeve-keys with shell substitution.
