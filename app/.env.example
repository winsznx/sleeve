# The app reads the repo root's .env.local through the symlink app/.env.local -> ../.env.local, and the root
# .env.example lists every variable. This file covers only the data source: "mock" runs the in-memory sample account
# and labels every screen as sample data, "chain" reads Robinhood Chain mainnet. Unset means mock, except a production
# build (SLEEVE_ENV=production), which refuses to start without an explicit value (next.config.ts).
NEXT_PUBLIC_SLEEVE_DATA_SOURCE=mock
