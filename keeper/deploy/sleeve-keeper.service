# Sleeve keeper on the owner's VPS (D-002). Installed by keeper/deploy/install.sh; the steps are in
# keeper/deploy/README.md. Logs go to journald: journalctl -u sleeve-keeper -f
#
# The keeper key stays root-only at /opt/sleeve/secrets/keeper.key. systemd hands the service a private copy in its
# credentials directory, and KEEPER_PRIVATE_KEY_FILE points there. keeper.env must not set KEEPER_PRIVATE_KEY_FILE:
# a value in an EnvironmentFile wins over Environment= below.

[Unit]
Description=Sleeve keeper (split and settle on Robinhood Chain)
Documentation=file:///opt/sleeve/keeper/current/README.md
After=network-online.target
Wants=network-online.target
# Keep restarting through an RPC or Supabase outage of any length.
StartLimitIntervalSec=0

[Service]
Type=simple
User=sleeve
Group=sleeve
WorkingDirectory=/opt/sleeve/keeper
EnvironmentFile=/opt/sleeve/secrets/keeper.env
LoadCredential=keeper.key:/opt/sleeve/secrets/keeper.key
Environment=KEEPER_PRIVATE_KEY_FILE=%d/keeper.key
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/opt/sleeve/node/bin/node --enable-source-maps /opt/sleeve/keeper/current/dist/main.js
Restart=always
RestartSec=10
# Exit code 2 means the configuration or the key file was refused, which a restart cannot fix.
RestartPreventExitStatus=2
KillSignal=SIGTERM
TimeoutStopSec=90

# Memory: one measured --once pass peaked at 112 MB resident. The limits stop a leak before it reaches the other
# projects on the host.
MemoryHigh=384M
MemoryMax=512M
TasksMax=64

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sleeve-keeper

# The only listener is the health endpoint, which the keeper binds to 127.0.0.1 itself. Outbound HTTPS reaches the
# RPC and Supabase. Nothing on the host is writable to the service.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
