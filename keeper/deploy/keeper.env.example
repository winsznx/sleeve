# Sleeve keeper environment, read by sleeve-keeper.service from /opt/sleeve/secrets/keeper.env (root, mode 600).
# Copy the variable names, never this file's comments, into that file on the server, and fill the values there.
# Do not set KEEPER_PRIVATE_KEY_FILE: the unit sets it to the key systemd hands the service.

# The keeper's own RPC: the QuickNode HTTPS endpoint on Robinhood Chain mainnet (D-032). Never the public RPC,
# which the verifier uses (D-008). Required.
KEEPER_RPC=

# The Supabase project and its service role key, the only key that can write the index. Required.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hold sorting while the base fee is above this, in gwei, until a payment has waited 24 hours (PRD 7.2).
KEEPER_GAS_CEILING_GWEI=0.1
# No transaction is priced above this per gas, whatever the reason to send, in gwei.
KEEPER_MAX_FEE_GWEI=1
# Hard gas limit per keeper call (audit A1-23). A SPY fill measured 543,779 (docs/GAS.md).
KEEPER_MAX_GAS=1200000

# Milliseconds between passes.
KEEPER_POLL_MS=5000
# GET /health on 127.0.0.1 only.
KEEPER_HEALTH_PORT=8787
# /health answers 503 when the index is further behind the head than this, in seconds.
KEEPER_MAX_LAG_SECONDS=120

# Blocks behind the head the index stays (about 6 seconds at 10 blocks a second).
KEEPER_CONFIRMATIONS=64
# Widest eth_getLogs range tried first; the keeper narrows it to what the provider takes.
KEEPER_LOG_CHUNK_BLOCKS=10000

# LOW_BALANCE below this much ETH on the keeper address.
KEEPER_MIN_BALANCE_ETH=0.001

# debug, info, warn, error or fatal.
KEEPER_LOG_LEVEL=info
