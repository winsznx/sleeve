{
  "name": "@sleeve/keeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sleeve/core": "workspace:*",
    "@supabase/supabase-js": "2.117.2",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.4",
    "@zerodev/ecdsa-validator": "5.4.9",
    "@zerodev/sdk": "5.5.10",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
