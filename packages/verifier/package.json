{
  "name": "@sleeve/verifier",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "sleeve": "./bin/sleeve.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist/cli.js",
    "lint": "node ../../scripts/copy-lint.mjs src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:fork": "vitest run --config vitest.fork.config.ts"
  },
  "dependencies": {
    "@sleeve/core": "workspace:*",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
